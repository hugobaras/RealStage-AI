{
  "name": "realstage-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=@realstage-ai/client",
    "dev:server": "npm run dev --workspace=@realstage-ai/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
