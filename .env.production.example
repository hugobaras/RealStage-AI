# Copier vers .env.production à la racine du projet :
#   cp .env.production.example .env.production
#
# Les variables VITE_* sont lues au BUILD Docker (docker compose build).
# Les autres sont lues au RUNTIME par le conteneur.

# --- Build frontend (Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

VITE_STRIPE_PUBLISHABLE_KEY=

# --- API (runtime) ---
PORT=3011

FAL_KEY=
FAL_MODEL=fal-ai/flux-2-lora-gallery/apartment-staging
FAL_DECLUTTER_MODEL=fal-ai/flux-2/edit

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Chemin sur l'hôte vers le JSON (monté dans le conteneur)
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./secrets/firebase-service-account.json
# Option B inline (sans fichier monté) :
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=

# URL publique de l'app (HTTPS recommandé)
CLIENT_URL=https://realstage.votredomaine.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RealStage AI <noreply@votredomaine.com>
REPORT_EMAIL_TO=support@votredomaine.com
