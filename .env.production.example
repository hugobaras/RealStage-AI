# Copier : cp .env.production.example .env.production
#
# Build Docker (les VITE_* doivent être passées au build) :
#   docker compose --env-file .env.production build --no-cache
#   docker compose --env-file .env.production up -d

# --- Build frontend (Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- API (runtime) ---
PORT=3011

FAL_KEY=
FAL_MODEL=fal-ai/flux-2-lora-gallery/apartment-staging
FAL_DECLUTTER_MODEL=fal-ai/flux-2/edit

FIREBASE_PROJECT_ID=
# Fichier monté par docker-compose : secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=

CLIENT_URL=https://realstage-ai.tech

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RealStage AI <noreply@votredomaine.com>
REPORT_EMAIL_TO=support@votredomaine.com
