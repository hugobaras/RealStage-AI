# Exemple Nginx — RealStage AI derrière le conteneur Docker (port 3011 en local)
#
# 1. Copier / adapter :
#    sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/realstage
#    sudo ln -sf /etc/nginx/sites-available/realstage /etc/nginx/sites-enabled/
#    sudo nginx -t && sudo systemctl reload nginx
#
# 2. Certificat TLS :
#    sudo certbot --nginx -d realstage.votredomaine.com

upstream realstage_app {
    server 127.0.0.1:3011;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name realstage.votredomaine.com;

    # Redirection HTTPS (décommenter après certbot)
    # return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name realstage.votredomaine.com;

    # ssl_certificate /etc/letsencrypt/live/realstage.votredomaine.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/realstage.votredomaine.com/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://realstage_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}
