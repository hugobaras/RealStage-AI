# RealStage AI — Nginx reverse proxy vers Docker (127.0.0.1:3011)
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/realstage
#   sudo ln -sf /etc/nginx/sites-available/realstage /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS (recommended):
#   sudo certbot --nginx -d realstage-ai.tech

upstream realstage_app {
    server 127.0.0.1:3011;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name realstage-ai.tech;

    client_max_body_size 20M;

    location / {
        proxy_pass http://realstage_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}

# Do not add a manual SSL server block here before running certbot.
# Certbot will create HTTPS and HTTP->HTTPS redirect for you.
