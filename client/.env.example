# Firebase Web App (Console Firebase > Paramètres du projet > Vos applications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optionnel — uniquement si Firebase Storage est activé sur votre projet
# VITE_FIREBASE_STORAGE_BUCKET=

# Stripe (clé publique — Dashboard > Développeurs > Clés API)
VITE_STRIPE_PUBLISHABLE_KEY=
