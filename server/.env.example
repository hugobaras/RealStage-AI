FAL_KEY=your_fal_api_key
# Virtual staging (recommandé) : fal-ai/flux-2-lora-gallery/apartment-staging
# Alternative générique : fal-ai/flux/dev/image-to-image
FAL_MODEL=fal-ai/flux-2-lora-gallery/apartment-staging
# Désencombrement : fal-ai/flux-2/edit (recommandé, une passe, sans artefacts)
# Alternatives : fal-ai/object-removal, fal-ai/image-editing/object-removal
FAL_DECLUTTER_MODEL=fal-ai/flux-2/edit
PORT=3001

# Firebase Admin (Console Firebase > Paramètres > Comptes de service > Générer une nouvelle clé privée)
FIREBASE_PROJECT_ID=
# Optionnel — uniquement si Firebase Storage est activé (sinon : Firestore seul)
# FIREBASE_STORAGE_BUCKET=
# Option A : chemin vers le fichier JSON téléchargé
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B : credentials inline (private_key avec \n pour les retours à la ligne)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (Produits > créer 3 abonnements mensuels)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=
# URL du client (redirections Checkout)
CLIENT_URL=http://localhost:5173
